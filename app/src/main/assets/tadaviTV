<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tadavi's TV OS — Colorful Quantum Dot Edition (Xiaomi S Mini LED 4K)</title>
  <!-- Tailwind CSS CDN with Fallback styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            claude: {
              bg: '#FAF7F2',
              surface: '#FFFFFF',
              subtle: '#F3EFEA',
              border: '#E5DEC9',
              text: '#181412',
              muted: '#5C544E',
              accent: '#FF5A26',
              accentSoft: '#FFF0EB'
            }
          },
          fontFamily: {
            serif: ['Newsreader', 'Georgia', 'serif'],
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --tv-brightness: 100%;
      --tv-contrast: 102%;
      --tv-saturate: 118%;
      --tv-Warmth: 0deg;
      --mesh-1: rgba(255, 94, 58, 0.22);
      --mesh-2: rgba(168, 85, 247, 0.20);
      --mesh-3: rgba(6, 182, 212, 0.20);
      --mesh-4: rgba(245, 158, 11, 0.18);
      --primary-grad: linear-gradient(135deg, #FF512F 0%, #DD2476 50%, #7928CA 100%);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #181412;
      background-color: #FDFBF7;
      background-image:
        radial-gradient(at 8% 12%, var(--mesh-1) 0px, transparent 48%),
        radial-gradient(at 90% 10%, var(--mesh-2) 0px, transparent 50%),
        radial-gradient(at 82% 84%, var(--mesh-3) 0px, transparent 52%),
        radial-gradient(at 15% 88%, var(--mesh-4) 0px, transparent 50%);
      background-attachment: fixed;
      filter: brightness(var(--tv-brightness)) contrast(var(--tv-contrast)) saturate(var(--tv-saturate)) hue-rotate(var(--tv-Warmth));
      transition: filter 0.25s ease, background-image 0.5s ease;
      overflow-x: hidden;
    }

    .claude-serif {
      font-family: 'Newsreader', Georgia, serif;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .tv-focusable {
      transition: all 0.26s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    .tv-focusable:hover,
    .tv-focusable:focus-visible {
      transform: translateY(-4px) scale(1.018);
      outline: none;
      box-shadow: 0 18px 36px -10px rgba(221, 36, 118, 0.26), 0 0 0 3px rgba(255, 90, 38, 0.42);
    }

    @keyframes auroraShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .aurora-ribbon {
      background: linear-gradient(90deg, #FF512F, #F09819, #EC4899, #8B5CF6, #06B6D4, #10B981, #FF512F);
      background-size: 300% 300%;
      animation: auroraShift 10s ease infinite;
    }

    .colorful-glass {
      background: rgba(255, 255, 255, 0.84);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
  </style>
</head>
<body class="min-name-screen">
  <div class="h-1.5 w-full aurora-ribbon fixed top-0 left-0 z-50 shadow-sm"></div>

  <!-- BOOT SCREEN -->
  <div id="boot-screen" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#FFFDF9]">
    <div class="text-center">
      <h1 class="claude-serif text-5xl font-bold bg-gradient-to-r from-[#FF512F] via-[#DD2476] to-[#6366F1] bg-clip-text text-transparent">
        Tadavi's TV OS
      </h1>
      <p class="text-slate-600 mt-2 font-mono text-sm">Initializing Xiaomi S Mini LED 4K...</p>
    </div>
  </div>

  <main class="p-10 text-center">
    <h1 class="text-4xl font-bold claude-serif">Welcome to Tadavi's TV OS</h1>
    <p class="mt-4 text-slate-700">Your custom Quantum Dot OS is running successfully on your Xiaomi TV.</p>
  </main>

  <script>
    window.onload = function () {
      setTimeout(() => {
        const boot = document.getElementById('boot-screen');
        if (boot) boot.style.display = 'none';
      }, 1500);
    };
  </script>
</body>
</html>
